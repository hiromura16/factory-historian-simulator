# ローカル実行の設定例。実値を共有せず、init_local.pyで作る.env側で運用値を指定する。
BIND_IP=127.0.0.1
APP_PORT=3642
AUTO_START=1

# ビルド用の任意プロキシ。上下の同名設定は常に同じ値にする。
# 既定はコメントのまま（未指定）。必要な場合だけ6行のコメントを外す。
# 有効な空欄は既存のクライアント設定を上書きし得る。実値をGitやログに残さない。
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,::1
# http_proxy=
# https_proxy=
# no_proxy=localhost,127.0.0.1,::1
